---
import config from "@/config"

const current_year = new Date().getFullYear();
const start_year = config.copyright.start
const end_year = config.copyright.end?? current_year
---

<div class="mio__footer">
    <div class="footer__wrapper">
        <div class="wrapper__upper">
            <span class="footer__text">&copy; {start_year} - {end_year}</span>
            <a href="/" class="footer__text footer__link">{config.author.name}</a>
            <span class="footer__text">All rights reserved.</span>

            <span class="footer__text">/</span>
            <a href="/rss.xml" class="footer__text footer__link">RSS</a>
            <span class="footer__text">/</span>
            <a href="/sitemap.xml" class="footer__text footer__link">Sitemap</a>
        </div>

        <div class="wrapper__lower">
            <span class="footer__text">Powered by </span>
            <a href="https://astro.build" class="footer__text footer__link">Astro</a>
            <span class="footer__text">&</span>
            <a href="https://github.com/CoderFrish/astro-theme-mio" class="footer__text footer__link">Mio</a>
        </div>
    </div>
</div>

<style>
    @reference "@/styles/tailwind.css";

    .mio__footer {
        @apply w-full py-12 bg-(--bg-secondary) rounded-t-md border border-(--border-default)
    }

    .footer__wrapper {
        @apply px-6 mx-auto max-w-7xl flex items-center flex-col
    }

    .wrapper__upper, .wrapper__lower {
        @apply flex items-center gap-1.5 flex-wrap justify-center
    }

    .footer__text {
        @apply text-sm text-(--text-muted)
    }

    .footer__link {
        @apply text-(--primary)
    }
</style>
