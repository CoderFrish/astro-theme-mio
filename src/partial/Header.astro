---
import config from "@/mio.config.ts"
import { Icon } from "astro-icon/components"

const currentPath = Astro.url.pathname;

const menu_suffix = (path: string) => {
    return currentPath === path? "--active": "--inactive"
}

const menus = [
    {name: "主页", path: "/"},
    {name: "分类", path: "/categories"},
    {name: "标签", path: "/tags"},
    {name: "归档", path: "/archives"}
]
---

<header class="mio__header">
    <nav class="nav">
        <div class="nav__wrapper">
            <a class="nav__brand" href="/">{config.brand? config.brand: config.title}</a>

            <div class="nav__menu">
                {menus.map(item => {
                    return <a href={item.path} class={"menu__link" + menu_suffix(item.path)}>{item.name}</a>
                })}
            </div>

            <div class="nav__toolbar">
                <button class="toolbar__btn" onclick=""><Icon name="mdi:magnify" /></button>
            </div>
        </div>
    </nav>
</header>

<style>
    @reference "@/styles/tailwind.css";

    .mio__header {
        @apply w-full fixed z-50
    }

    .nav__menu {
        @apply flex gap-4
    }

    .menu__link--inactive {
        transition: all 150ms ease;

        &:hover {
            @apply bg-(--bg-hover) text-(--text-primary)
        }

        @apply text-sm px-2.5 py-2 rounded-md text-(--text-muted)
    }

    .menu__link--active {
        @apply text-sm px-2.5 py-2 rounded-md text-(--color-primary) bg-(--color-primary-light)
    }

    .nav__brand {
        @apply text-xl tracking-wide font-light text-(--text-primary)
    }

    .nav {
        border-color: var(--border-default);

        @apply h-16.25 rounded-b-md bg-(--bg-surface)/90 backdrop-blur-md border
    }

    .nav__toolbar {
        @apply flex items-center flex-row gap-1
    }

    .toolbar__btn {
        transition: all 150ms ease;

        &:hover {
            @apply bg-(--bg-hover) cursor-pointer;
        }

        @apply flex items-center justify-center size-9 rounded-md text-xl text-(--text-primary)
    }

    .nav__wrapper {
        @apply h-full mx-auto px-6 max-w-7xl flex items-center justify-between
    }
</style>
