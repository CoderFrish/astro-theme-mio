    Head,
    Footer,
    Header,
    Content
} from "@/partial";

import "@/styles/tailwind.css"
import "@/styles/mio-theme.css"
import "@/styles/global.css"
import { Author, Categories } from "@/widget";
---

<!DOCTYPE html>
<html>
    <Head />

    <body>
        <Header />

        <Content>
            <slot />

            <Author slot="sidebar" />

            <Categories slot="sidebar" />

            <slot name="sidebar" slot="sidebar" />
        </Content>

        <Footer />
    </body>

</html>
